## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2017 auto generated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUNIT
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# BenchmarkDotNet
BenchmarkDotNet.Artifacts/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# FxCop
FxCopReport.xml

# Service Fabric
*.apk
*.ap_

# Clippy
_vti_cnf/
_vti_pvt/
_vti_bin/
_vti_txt/

# R#
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustMock
*.jmconfig

# OmniSharp
.omnisharp/

# DotCover
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject
DocProject/buildhelp/
DocProject/Help/Html2/
DocProject/Help/html/

# Click-Once directory
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# Note: Comment the next line if you want to checkin your web deploy settings,
# but database connection strings (with potential passwords) will be unencrypted
*.pubxml
*.publishproj

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# checkin your Microsoft Azure Web App publish settings, but sensitive information
# contained in these scripts will be unencrypted
PublishScripts/

# NuGet Packages
*.nupkg
# The packages folder can be checked in if you wish, but the recommended
# way is to not check it in.
packages/
# !packages/build/  # If you need the build tool
# If you didn't check in the packages', you may need the _nuget.xml file
#_nuget.xml

# VS 2019/2022
*.v16.suo
*.v17.suo

# Windows Azure Build Output
csx/
*.build.csdef

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Including strong name key files is recommended
# *.snk

# Since there are multiple workflows, uncomment next line to ignore bower_components
# bower_components/

# RIA/Silverlight projects
Generated_Code/

# Helper Files
/helpers/

# KendoUI
js/kendo.all.min.js
js/kendo.web.min.js
js/kendo.mobile.min.js
styles/kendo.common.min.css
styles/kendo.rtl.min.css
styles/kendo.default.min.css

# Core Tools
.toolstarget

# PostSharp
[Pp]ost[Ss]harp[Bb]in/
[Pp]ost[Ss]harp[Oo]bj/

# NDepend
NDependOut/

# All modern editors
.vscode/

# Application Specific
env.json
.env
.env.*
!.env.example
npm-debug.log
yarn-error.log
node_modules/
dist/
build/
